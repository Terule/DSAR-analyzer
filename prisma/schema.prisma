generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ProcessedFile {
  id                      String   @id
  filename                String?
  filepath                String?
  file_size_bytes         BigInt   @default(0)
  status                  String   @default("pending")
  total_emails            Int      @default(0)
  total_attachments       Int      @default(0)
  unique_emails           Int      @default(0)
  duplicate_emails        Int      @default(0)
  estimated_tokens        Int      @default(0)
  created_at              DateTime @default(now())
  ai_status               String   @default("pending")
  // none | screening | done. Between the email audit and Render the coordinator
  // screens attachments (and, in client cases, bodies) for confidential content.
  mail_screen_status      String   @default("none")
  ai_approved_count       Int      @default(0)
  ai_discarded_count      Int      @default(0)
  ai_batches_total        Int      @default(0)
  ai_batches_done         Int      @default(0)
  pdf_status              String   @default("pending")
  batch_id                String?
  subject_name            String?
  subject_email           String?
  subject_personal_email  String?
  subject_aliases         String?
  metadata_duration_ms    Int      @default(0)
  analyze_duration_ms     Int      @default(0)
  extract_duration_ms     Int      @default(0)
  ai_started_at           BigInt?
  ai_duration_ms          Int      @default(0)
  pdf_duration_ms         Int      @default(0)
  pdf_total               Int      @default(0)
  pdf_processed           Int      @default(0)
  kind                    String   @default("pst")
  files_status            String   @default("pending")
  files_total             Int      @default(0)
  files_progress_total    Int      @default(0)
  files_progress_handled  Int      @default(0)
  files_processed         Int      @default(0)
  files_skipped           Int      @default(0)
  files_duplicates        Int      @default(0)
  files_duration_ms       Int      @default(0)
  files_started_at        BigInt?
  files_paused_ms         Int      @default(0)
  upload_status           String   @default("idle")
  upload_total            Int      @default(0)
  upload_uploaded         Int      @default(0)
  upload_error            String?
  upload_heartbeat_at     BigInt?
  case_request_id         String?
  wave                    Int      @default(1)

  emails Email[] @relation("ProcessedFileEmails")
  ai_batch_runs AiBatchRun[] @relation("CoordinatorAiBatchRuns")
  files_ai_verdicts FilesAiVerdict[] @relation("FilesAiVerdicts")
  sharepoint_upload_artifacts SharePointUploadArtifact[]
  case_request CaseRequest? @relation(fields: [case_request_id], references: [id], onDelete: Cascade)

  @@index([case_request_id, wave])
  @@map("processed_files")
}

model ManagedCase {
  id                    String        @id
  name                  String        @unique
  subject_name          String
  subject_email         String
  subject_personal_email String?
  subject_aliases       String?
  matter_numbers        String?
  case_type             String        @default("employee")
  onetrust_request_id   String?
  onetrust_request_queue_id String?
  onetrust_form_id    String?
  onetrust_trace_id   String?
  onetrust_status       String        @default("idle")
  onetrust_error        String?
  status                String        @default("active")
  archived_at           DateTime?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  requests              CaseRequest[]
  onetrust_upload_artifacts OneTrustUploadArtifact[]

  @@map("managed_cases")
}

model OneTrustUploadArtifact {
  id                  String   @id
  case_id             String
  local_path          String   @unique
  relative_path       String
  attachment_name     String
  file_size_bytes     BigInt
  modified_at         BigInt
  remote_file_id      String?
  status              String   @default("pending")
  attempts            Int      @default(0)
  error_message       String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  case ManagedCase @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id, status])
  @@map("onetrust_upload_artifacts")
}

model CaseRequest {
  id                    String        @id
  case_id               String
  name                  String
  scope                 String
  status                String        @default("ready")
  staging_path          String
  deliverable_path      String
  pst_count             Int           @default(0)
  pst_size_bytes        BigInt        @default(0)
  files_count           Int           @default(0)
  files_size_bytes      BigInt        @default(0)
  deliverable_files     Int           @default(0)
  deliverable_size_bytes BigInt       @default(0)
  total_emails          Int           @default(0)
  emails_exported       Int           @default(0)
  files_exported        Int           @default(0)
  error                 String?
  wave                  Int           @default(1)
  wave_scope            String?
  render_base           Int?
  warning_base          Int?
  files_doc_base        Int?
  files_msg_base        Int?
  started_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  case                  ManagedCase   @relation(fields: [case_id], references: [id], onDelete: Cascade)
  processed_files       ProcessedFile[]
  items                 Item[]

  @@unique([case_id, name])
  @@index([status, created_at])
  @@map("case_requests")
}

model SharePointUploadArtifact {
  id                  String   @id
  source_file_id      String
  request_key         String
  local_path          String   @unique
  relative_path       String
  file_size_bytes     BigInt
  modified_at         BigInt
  status              String   @default("pending")
  attempts            Int      @default(0)
  error_message       String?
  heartbeat_at        BigInt?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  source_file ProcessedFile @relation(fields: [source_file_id], references: [id], onDelete: Cascade)

  @@index([status, heartbeat_at])
  @@index([source_file_id, status])
  @@map("sharepoint_upload_artifacts")
}

model Email {
  id                String  @id
  file_id           String?
  message_id        String?
  sent_date         String?
  email_hash        String  @unique
  is_duplicate      Int     @default(0)
  parent_email_hash String?
  is_attachment     Int     @default(0)

  processed_file ProcessedFile? @relation("ProcessedFileEmails", fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([file_id])
  @@index([message_id])
  @@map("emails")
}

// Each Bedrock Batch submission has a durable row.  Email rows are claimed by
// this row before upload, which makes parallel submission safe and lets us
// retry only request lines that did not yield a decision.
model AiBatchRun {
  id             String   @id
  coordinator_id String
  openai_batch_id String? @unique
  status         String   @default("claiming")
  request_count  Int      @default(0)
  estimated_tokens Int    @default(0)
  retry_count    Int      @default(0)
  // email = the email audit; files = Files, attachments and mail screening.
  kind           String   @default("email")
  // 1 = first submission; 2 = the one automatic resubmission (files runs).
  attempt        Int      @default(1)
  error          String?
  created_at     DateTime @default(now())
  submitted_at   DateTime?
  // The terminal timestamp reported by the AI service, distinct from the time this
  // application downloads and applies the output.
  openai_completed_at DateTime?
  completed_at   DateTime?

  coordinator ProcessedFile @relation("CoordinatorAiBatchRuns", fields: [coordinator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items  Item[]  @relation("AiBatchRunItems")
  verdicts FilesAiVerdict[]

  @@index([coordinator_id, status])
  @@index([kind, status])
  @@map("ai_batch_runs")
}

// The Files AI relevance check: one verdict per converted file of a Files row,
// judged in Bedrock Batch runs. Kept separate from the email AI tables.

model FilesAiVerdict {
  id           String   @id
  file_id      String
  rel_path     String
  verdict      String?
  reason       String?
  sampled      Boolean  @default(false)
  // verdict is keep | discard | review. "review" = a person decides; the file
  // sits in "For Human Review/" and is neither numbered nor uploaded.
  relevance    String?
  sensitivity  String?
  subject_involved Boolean @default(false)
  large_file   Boolean  @default(false)
  batch_run_id String?
  created_at   DateTime @default(now())
  resolved_at  DateTime?
  // Haiku 4.5 (Bedrock Batch) discards that show doubt are judged again by
  // Haiku 5.5: p_keep is the 4.5's own 0-100 "should be kept" estimate,
  // rereview_status is pending | running until the second opinion lands.
  p_keep       Int?
  rereview_status    String?
  rereview_queued_at DateTime?
  rereview_started_at DateTime?
  first_reason String?
  reviewed_by_model String?

  file ProcessedFile @relation("FilesAiVerdicts", fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run  AiBatchRun? @relation(fields: [batch_run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([file_id, verdict])
  @@index([rereview_status])
  @@map("files_ai_verdicts")
}

// A single operator-managed row controls live pipeline throughput.  Workers
// read this before filling slots, so adjustments take effect without restarting
// already accepted Batch jobs.
model PipelineSettings {
  id                          String   @id
  sharepoint_site_url         String?
  sharepoint_folder_id        String?
  sharepoint_folder_path      String?
  sharepoint_upload_lease_owner String?
  sharepoint_upload_lease_until BigInt?
  staging_root                  String?
  deliverables_root             String?
  azure_tenant_id_encrypted     String?
  azure_client_id_encrypted     String?
  azure_client_secret_encrypted String?
  onetrust_tenant_url            String?
  onetrust_template_id           String?
  onetrust_public_webform_url    String?
  onetrust_language              String?
  onetrust_request_type          String?
  onetrust_subject_type          String?
  onetrust_date_raised_field_key String?
  onetrust_system_label          String?
  onetrust_client_id_encrypted   String?
  onetrust_client_secret_encrypted String?
  delete_source_psts          Boolean  @default(true)
  files_concurrency           Int      @default(6)
  files_ai_enabled            Boolean  @default(true)
  rereview_min_p_keep         Int      @default(8)
  rereview_sample_percent     Float    @default(2)
  updated_at                  DateTime @updatedAt

  @@map("pipeline_settings")
}

model RunHistory {
  id                   String   @id
  source_file_id       String
  source_kind          String?
  filename             String?
  filepath             String?
  case_key             String?
  request_key          String?
  status               String?
  ai_status            String?
  pdf_status           String?
  files_status         String?
  total_emails         Int      @default(0)
  unique_emails        Int      @default(0)
  duplicate_emails     Int      @default(0)
  ai_approved_count    Int      @default(0)
  ai_discarded_count   Int      @default(0)
  files_total          Int      @default(0)
  files_processed      Int      @default(0)
  files_skipped        Int      @default(0)
  files_duplicates     Int      @default(0)
  metadata_duration_ms Int      @default(0)
  analyze_duration_ms  Int      @default(0)
  extract_duration_ms  Int      @default(0)
  ai_duration_ms       Int      @default(0)
  pdf_duration_ms      Int      @default(0)
  files_duration_ms    Int      @default(0)
  terminal_outcome     String
  archived_reason      String
  state_signature      String
  finalized_at         DateTime
  created_at           DateTime @default(now())

  @@unique([source_file_id, state_signature])
  @@index([case_key])
  @@index([terminal_outcome])
  @@map("run_history")
}

model CaseHistory {
  id                   String   @id
  case_key             String
  request_key          String?
  source_rows          Int      @default(0)
  pst_rows             Int      @default(0)
  files_rows           Int      @default(0)
  total_emails         Int      @default(0)
  unique_emails        Int      @default(0)
  duplicate_emails     Int      @default(0)
  emails_selected      Int      @default(0)
  emails_discarded     Int      @default(0)
  files_total          Int      @default(0)
  files_processed      Int      @default(0)
  files_skipped        Int      @default(0)
  files_duplicates     Int      @default(0)
  metadata_duration_ms Int      @default(0)
  analyze_duration_ms  Int      @default(0)
  extract_duration_ms  Int      @default(0)
  ai_duration_ms       Int      @default(0)
  pdf_duration_ms      Int      @default(0)
  files_duration_ms    Int      @default(0)
  total_duration_ms    Int      @default(0)
  terminal_outcome     String
  archived_reason      String
  state_signature      String
  finalized_at       DateTime
  created_at         DateTime @default(now())

  @@unique([case_key, state_signature])
  @@map("case_history")
}

model OneTrustForm {
  id                  String   @id @default(uuid())
  name                String
  template_id         String
  api_token_encrypted String
  date_raised_field_key String @default("formField81")
  system_label        String   @default("AIDA")
  language            String   @default("en-gb")
  subject_type        String   @default("Customer")
  // JSON array of the case details a request needs (see onetrust-forms.ts).
  required_fields     String   @default("[\"subject_name\",\"work_email\"]")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("onetrust_forms")
}

// Audit trail (docs/pipeline-refactor.md, step 0, shadow mode): one row per
// email, file, attachment or chat message, with the rule that last decided it.
// It only records what the pipeline already decided; no stage reads it yet.
model Item {
  id              String   @id
  case_request_id String?
  file_id         String?
  parent_id       String?
  kind            String
  origin          String
  // What a person recognises: the subject of an email, the path of a file, the
  // name of an attachment. Shown in the audit trail CSV and the decisions panel.
  label           String?
  // pending | kept | discarded | review
  state           String   @default("pending")
  decision_rule   String?
  reason          String?
  decided_by      String?
  cascade         Boolean  @default(false)
  // The AI work queue of an email item: pending = waiting for the AI. The Batch
  // run that claimed it, the 4.5 confidence (0-100) and the second-review lease.
  ai_batch_run_id         String?
  ai_p_keep               Int?
  rereview_status         String?
  rereview_queued_at      DateTime?
  rereview_started_at     DateTime?
  rereview_coordinator_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  case_request CaseRequest? @relation(fields: [case_request_id], references: [id], onDelete: Cascade)
  ai_batch_run AiBatchRun?  @relation("AiBatchRunItems", fields: [ai_batch_run_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events       ItemEvent[]

  @@index([case_request_id, state])
  @@index([file_id])
  @@index([ai_batch_run_id])
  @@index([rereview_status])
  @@map("items")
}

// Every change of an item's state, with the rule, reason and who decided.
model ItemEvent {
  id            String   @id @default(uuid())
  item_id       String
  state         String
  decision_rule String?
  reason        String?
  decided_by    String?
  created_at    DateTime @default(now())

  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id])
  @@map("item_events")
}
