{
  "name": "pst-analyser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "orchestrator:worker": "node --import tsx scripts/orchestrator/dispatcher.ts",
    "dispatcher": "node --import tsx scripts/orchestrator/dispatcher.ts",
    "job:run": "node --import tsx scripts/orchestrator/job-runner.ts",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "docker compose up -d --build --force-recreate app",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:ps": "docker compose ps",
    "postinstall": "node scripts/patch-openai-tsconfig.mjs",
    "reset:ai:case": "node --import tsx scripts/reset-ai-case.ts",
    "history:backfill": "node --import tsx scripts/maintenance/backfill-case-history.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@kenjiuno/msgreader": "^1.28.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/mailparser": "^3.4.6",
    "bullmq": "^5.80.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "js-tiktoken": "^1.0.21",
    "letterparser": "^0.1.8",
    "lucide-react": "^1.21.0",
    "mailparser": "^3.9.12",
    "mammoth": "^1.12.0",
    "next": "16.2.7",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.0.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "puppeteer",
    "sharp",
    "unrs-resolver"
  ],
  "allowScripts": {
    "sharp": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
