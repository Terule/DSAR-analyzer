# Docker-first runtime values (copy to .env and adjust host paths)

# Host paths mounted into the app container
HOST_STAGING_PATH="/absolute/path/to/staging-area"
HOST_EXTRACTED_PATH="/absolute/path/to/extracted-emails"

# App runtime paths inside container (do not change)
STAGING_PATH="/data/staging-area"
EXTRACTED_PATH="/data/extracted-emails"

# Providers
EXECUTION_PROVIDER="local-process"
QUEUE_PROVIDER="bullmq"
CONTROL_PLANE_POOL_MAX="10"
ORCHESTRATOR_QUEUE_NAME="pst-analyser-orchestrator"

# Backend URLs
POSTGRES_URL="postgres://pst:pst@localhost:5432/pst_analyser"
REDIS_URL="redis://localhost:6379"
POSTGRES_URL_DOCKER="postgres://pst:pst@postgres:5432/pst_analyser"
REDIS_URL_DOCKER="redis://redis:6379"

# Required
OPENAI_API_KEY="sk-..."
